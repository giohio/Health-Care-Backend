GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
CLINICAL_SERVICE_URL=http://localhost:8004
EMR_RESULT_SERVICE_URL=http://localhost:8005
REDIS_URL=redis://localhost:6379/0

# ─── RAG ────────────────────────────────────────────────────────────────────
# Before enabling, run the ingestion pipeline once:
#   cd Rag/knowledge_base && python run_pipeline.py
# This creates the "clinical_guidelines" Qdrant collection and loads medical
# content chunks.  Without ingestion the retriever returns empty context.
RAG_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=clinical_guidelines   # must match the collection created by run_pipeline.py
OLLAMA_URL=http://ollama:11434
