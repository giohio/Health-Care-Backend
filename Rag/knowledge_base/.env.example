# ──────────────────────────────────────────────────────────────────────────────
# HealthAI Knowledge Base — environment overrides
# Copy to .env and edit before running the pipeline or checks.
# ──────────────────────────────────────────────────────────────────────────────

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
# Default: http://localhost:6333  (works with Docker Desktop or docker-compose on the host)
#
# Running Docker INSIDE WSL2 (not Docker Desktop)?
#   Ports are not forwarded to Windows localhost automatically.
#   Get your WSL2 IP and set this:
#
#     $ wsl hostname -I          # prints e.g.  172.22.80.1
#     QDRANT_URL=http://172.22.80.1:6333
#
# Or run all Python scripts from inside WSL:
#     $ wsl python checks/run_all_checks.py

# QDRANT_URL=http://localhost:6333

# ── Embedding server (Ollama) ─────────────────────────────────────────────────
# Default: http://localhost:11434
# Same WSL caveat as above — use the WSL IP if running Python on Windows.

# OLLAMA_HOST=http://localhost:11434
